# ===== Admin account =====
# Only used to seed the FIRST admin when the database is empty. Changing these
# later has no effect — use `npm run admin:password` to change the password.
ADMIN_USERNAME=admin
# Leave unset in production: a random password is generated and printed once,
# which is safer than shipping a value that also lives in this file.
# ADMIN_PASSWORD=

# Signs admin session cookies. Anyone who knows this value can mint a session
# for any admin, so it must be unique per deployment and never committed.
# The app refuses to start in production if this is missing, shorter than 32
# characters, or left as the example value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# ===== Network =====
# Number of reverse proxies in front of this app (nginx, ALB, Cloudflare...).
# The client IP used for rate limiting is read this many hops from the right of
# X-Forwarded-For, so entries a client injects on the left are ignored.
# Use 0 when the app is exposed directly — the header is then not trusted at all.
TRUSTED_PROXY_HOPS=1
# Set to 1 only when traffic really passes through Cloudflare.
# TRUST_CF_CONNECTING_IP=0

# Optional: override the backend API base used by the client.
# Defaults to "/api/v1" (same origin).
# NEXT_PUBLIC_API_BASE=/api/v1

# ===== Pixel Partner API v2 =====
# Server-side only. NEVER prefix this with NEXT_PUBLIC_ — it must not reach
# the browser. Obtain the key from the Telegram bot with the /api command.
PIXEL_API_KEY=pxl_your_key_here

# Optional: override the Pixel API base URL.
# PIXEL_API_BASE=https://api.smm.io.vn
